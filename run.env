# dotkit run configuration
# Fetched before cloning — no secrets here, just paths and preferences.
#
# Netinstall: curl sh.dotkit.run | sh
# Offline:    sh core/run.sh .

# Optional doorknock passphrase hash
# Generate: printf '%s' "passphrase" | md5sum | cut -d' ' -f1
DOTKIT_PASSPHRASE_HASH="7e0a4e3e87f404101afc3560977d35d9"

# Core provisioner source
#   local                            → use bundled core/ or cached ~/.local/share/dotkit/core
#   /path/to/core                    → absolute local path (for development)
#   https://github.com/org/core.git  → clone from URL
DOTKIT_CORE=/Users/bhajneet/dev/dotkit/core

# Default profile (prompts if not set)
DOTKIT_DEFAULT_PROFILE=work

# Default dev directory (profile.txt can override per profile)
DOTKIT_DEFAULT_DEV_DIR=~/dev

# Modules directory override — dev only, points to local modules repo.
# In production: omit this. Modules are fetched individually from module-src
# URLs declared in profile data files (or default dotkit-org/modules).
DOTKIT_MODULES_DIR=/Users/bhajneet/dev/dotkit/modules

# SSH keys private repo (GitHub API contents URL)
DOTKIT_SSH_KEYS_URL=""
